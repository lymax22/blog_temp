{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run audit:dt14-online && hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "prepare:ecos:public": "node build-tools/prepare-ecos-deployment.mjs public/tools/ecos",
    "server": "hexo server",
    "verify:ecos:public": "node build-tools/verify-ecos-deployment.mjs --deployment public/tools/ecos",
    "verify:ecos:source": "node build-tools/verify-ecos-deployment.mjs --source source/tools/ecos",
    "audit:dt14-online": "node scripts/project-terminal-online-solve.mjs"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-pandoc": "^0.5.0",
    "hexo-renderer-stylus": "^3.0.0",
    "hexo-server": "^3.0.0",
    "hexo-theme-landscape": "^1.0.0",
    "hexo-theme-next": "^8.28.0"
  }
}
